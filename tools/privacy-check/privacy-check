#!/bin/sh
# privacy-check: 人間の発言の逐語を載せる節の見出しを、コミットの時点で止める。
#
# 使い方:
#   privacy-check [<file> ...]   ファイルを点検する。引数が無ければ git 管理下の全ファイル
#   privacy-check --stdin        標準入力のテキストを点検する（PR の本文など）
#   privacy-check --commit-msg <file>
#                                コミットメッセージのファイルを点検する。git が捨てる行は読まない
#                                （はさみ線より下の差分。案内のコメントがあるメッセージでは行頭コメントも）
#
# 点検は heading の1つ: Markdown（*.md / *.markdown と標準入力）の見出し行に、発言をそのまま
# 載せる節を示す語がある。地の文は見ない。「書かない」ことを述べる見出しは止めない。
# 非公開の名前は機械で照合しない（決まりとレビューで止める。ADR DOC-2611181132）。
#
# 出力は `<path>:<行番号>: heading`。ヒットありで終了コード 1、無しで 0、使い方の誤りは 2。
# 行に `privacy-check:allow-line` があれば、その行は飛ばす。ファイル単位の許可は
# このスクリプトと同じ場所の allowlist.txt（1行1パス。リポジトリのルートからの相対パス）。
# 置き場・設計の理由は README.md を参照。

set -u

_self_dir=$(cd "$(dirname "$0")" && pwd) || exit 2
_allowlist="$_self_dir/allowlist.txt"

[ -f "$_allowlist" ] || _allowlist=""

_stdin=0
_cmsg=0
_cc="#"
case "${1:-}" in
  --stdin)
    _stdin=1
    shift
    ;;
  --commit-msg)
    _cmsg=1
    shift
    _cc=$(git config --get core.commentChar 2>/dev/null || true)
    case "$_cc" in
      "" | auto) _cc="#" ;;
    esac
    ;;
esac
# git は、エディタを開いたときだけ案内のコメント行を足し、その行頭コメントを捨てる。
# -m / -F のコミットでは行頭が # の行もメッセージに残るので、案内があるときだけコメント行を飛ばす。
_cguide=0
if [ "$_cmsg" -eq 1 ] && [ "$#" -gt 0 ] && grep -F -q "$_cc Please enter" -- "$1" 2>/dev/null; then
  _cguide=1
fi
if [ "$_stdin" -eq 1 ] && [ "$#" -gt 0 ]; then
  echo "usage: privacy-check [<file> ...] | --stdin | --commit-msg <file>" >&2
  exit 2
fi

_tmp=$(mktemp -d) || exit 2
trap 'rm -rf "$_tmp"' EXIT

# 点検対象のファイル名を1行1つで $_tmp/list に作る。バイナリ・空・存在しないファイルは除く。
if [ "$_stdin" -eq 0 ]; then
  if [ "$#" -gt 0 ]; then
    printf '%s\n' "$@" >"$_tmp/cand"
  else
    git -c core.quotePath=false ls-files >"$_tmp/cand" || exit 2
  fi
  : >"$_tmp/list"
  while IFS= read -r _f; do
    [ -f "$_f" ] && grep -Iq . -- "$_f" 2>/dev/null && printf '%s\n' "$_f" >>"$_tmp/list"
  done <"$_tmp/cand"
  set --
  while IFS= read -r _f; do
    set -- "$@" "$_f"
  done <"$_tmp/list"
  [ "$#" -gt 0 ] || exit 0
fi

# バイト単位で比べる（日本語の語を locale に左右されず部分一致させる）。
LC_ALL=C awk -v stdin_mode="$_stdin" -v cmsg="$_cmsg" -v cguide="$_cguide" -v cc="$_cc" -v allow_file="$_allowlist" '
function trim(s) {
  sub(/^[ \t\r]+/, "", s)
  sub(/[ \t\r]+$/, "", s)
  return s
}
function norm(p) {
  while (sub(/^\.\//, "", p)) {}
  return p
}
BEGIN {
  # 発言をそのまま載せる節であることを示す語（公開してよい一覧）
  nw = split("逐語 持ち主の言葉 持ち主の発言 人間の発言 人間の言葉 発言の原文 依頼の原文 原文", words, " ")
  # 「書かない」ことを述べる見出しは止めない
  # 書くこと自体を否定する語。守る側の語（要約など）が同居しても、書かないと述べる見出しである
  nn = split("書かない 写さない 残さない 載せない 引用しない", negs, " ")
  # 「入れない」「含めない」「禁止」は、要約・改変・省略をしない等（逐語を守る側）にかかる形もある。
  # その語が同居していれば逐語の節の見出しとして扱う
  nw2 = split("入れない 含めない 禁止", wneg, " ")
  np = split("要約 改変 省略 手を 加え 変え", prot, " ")
  while (allow_file != "" && (getline line < allow_file) > 0) {
    sub(/#.*/, "", line)
    line = trim(line)
    if (line != "") allow[norm(line)] = 1
  }
  hits = 0
}
FNR == 1 {
  label = stdin_mode ? "<stdin>" : FILENAME
  skip = (!stdin_mode && (norm(FILENAME) in allow))
  markdown = stdin_mode || FILENAME ~ /\.(md|markdown)$/
  cut = 0
}
cmsg && cut { next }
cmsg && index($0, cc " ------------------------ >8 ------------------------") == 1 { cut = 1; next }
cmsg && cguide && substr($0, 1, length(cc)) == cc { next }
skip { next }
index($0, "privacy-check:allow-line") { next }
{
  if (markdown && $0 ~ /^ ? ? ?#+([ \t]|$)/) {
    h = 0
    for (i = 1; i <= nw; i++) if (index($0, words[i])) { h = 1; break }
    neg = 0
    for (i = 1; i <= nn; i++) if (index($0, negs[i])) { neg = 1; break }
    wneg_hit = 0
    for (i = 1; i <= nw2; i++) if (index($0, wneg[i])) { wneg_hit = 1; break }
    prot_hit = 0
    for (i = 1; i <= np; i++) if (index($0, prot[i])) { prot_hit = 1; break }
    if (neg || (wneg_hit && !prot_hit)) h = 0
    if (h) { printf "%s:%d: heading\n", label, FNR; hits++ }
  }
}
END { exit hits > 0 ? 1 : 0 }
' "$@"
