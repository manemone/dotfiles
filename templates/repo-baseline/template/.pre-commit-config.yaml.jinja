{#- Ruby のとき lint・test フックを走らせるファイル。文書だけのコミットでは走らせない -#}
{%- set ruby_files_regex = '(\\.(rb|rake|gemspec)$|^(Gemfile|Gemfile\\.lock|Rakefile|\\.rspec|\\.ruby-version|\\.rubocop[^/]*\\.yml)$)' -%}
# commit-msg 段を入れても、段を指定していないフックはコミットごとに1回だけ走るように、
# 既定の段を pre-commit に固定する（commit-msg 段で動かすフックは個別に stages を持つ）。
default_stages: [pre-commit]
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-merge-conflict
      - id: check-added-large-files
      - id: check-yaml
      - id: check-json

  # 人間の発言の逐語の節と非公開の名前を止める点検。commit-msg 段は
  # `pre-commit install --hook-type commit-msg` を一度実行しないと効かない。
  - repo: local
    hooks:
      - id: privacy-check
        name: privacy-check (発言の逐語の節・非公開の名前の検出)
        entry: ./tools/privacy-check/privacy-check
        language: system
        types: [text]
        stages: [pre-commit]

      - id: privacy-check-commit-msg
        name: privacy-check (コミットメッセージ)
        entry: ./tools/privacy-check/privacy-check --commit-msg
        language: system
        stages: [commit-msg]
{% if use_doc_id %}
  # フック配布元になるにはリポジトリルートに .pre-commit-hooks.yaml が必要なため、
  # 独立リポジトリ化するまでは repo: local を使う。
  - repo: local
    hooks:
      - id: doc-id-check
        name: doc-id check (命名規則違反の検出)
        entry: ./tools/doc-id/doc-id check
        language: ruby
        pass_filenames: false

      - id: doc-id-verify
        name: doc-id verify (切れ参照の検出)
        entry: ./tools/doc-id/doc-id verify
        language: ruby
        pass_filenames: false

      - id: doc-id-test
        name: doc-id test (minitest)
        entry: ruby tools/doc-id/test/doc_id_test.rb
        language: ruby
        pass_filenames: false
        files: ^tools/doc-id/
{% endif -%}
{% if lint_cmd %}
  - repo: local
    hooks:
      - id: lint
        name: {{ ("lint: " ~ lint_cmd) | tojson }}
        entry: {{ lint_cmd | tojson }}
        language: system
        pass_filenames: false
{%- if language == 'ruby' %}
        files: {{ ruby_files_regex | tojson }}
{%- endif %}
{% endif -%}
{% if test_cmd %}
  - repo: local
    hooks:
      - id: test
        name: {{ ("test: " ~ test_cmd) | tojson }}
        entry: {{ test_cmd | tojson }}
        language: system
        pass_filenames: false
{%- if language == 'ruby' %}
        files: {{ ruby_files_regex | tojson }}
{%- endif %}
{% endif -%}
