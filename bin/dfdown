#!/usr/bin/env bash
set -euo pipefail

# dfdown — pull everything in <host>:~/dfxfer/outbox/ down to ~/dfxfer/<host>/in/.
#
# Run from the *local* machine, with no arguments. Any arguments given are
# passed straight through to rsync, so `dfdown -n` is a dry run.
#
# Configuration (export these from ~/.zshrc.local):
#   DFXFER_HOSTS             space-separated ssh Host aliases
#   DFXFER_HOST              the default one
#   DFXFER_DIR               local base directory      (default: ~/dfxfer)
#   DFXFER_REMOTE_DOWN_DIR   remote download directory (default: dfxfer/outbox)
#   DFXFER_RSYNC             force a specific rsync binary
#
# See bin/README.md §3.6 and docs/planning/DOC-2609172237_file-handoff_計画.md.

# ── Locate dfxfer-lib.sh ──────────────────────────────────────────────
#
# ~/bin/dfdown is a symlink into the deployed generation, so $0's directory is
# ~/bin, not the directory holding the library. Walk the symlink chain by
# hand: `readlink -f` would do it in one line on Linux but does not exist on
# macOS (AGENTS.md "クロスプラットフォーム制約" names it specifically).
#
# This bootstrap is duplicated from bin/dfup because it cannot live in the
# library — it is what finds the library.
_dfdown_self="${BASH_SOURCE[0]}"
while [ -L "$_dfdown_self" ]; do
  _dfdown_dir=$(cd -P "$(dirname "$_dfdown_self")" && pwd)
  _dfdown_self=$(readlink "$_dfdown_self")
  case "$_dfdown_self" in
    /*) ;;
    *) _dfdown_self="$_dfdown_dir/$_dfdown_self" ;;
  esac
done
_dfdown_dir=$(cd -P "$(dirname "$_dfdown_self")" && pwd)

# shellcheck source=SCRIPTDIR/dfxfer-lib.sh
. "$_dfdown_dir/dfxfer-lib.sh"

# ── Transfer ──────────────────────────────────────────────────────────

host=$(dfxfer_host)
local_dir=$(dfxfer_local_dir "$host" in)
remote_dir=$(dfxfer_remote_dir down)

# A dry run must not touch the remote either — creating the receive
# directory would be a real, non-reversed-by-nothing side effect that "-n
# changes nothing" does not lead anyone to expect.
if dfxfer_has_dry_run_flag ${1+"$@"}; then
  log_info "Dry run: not creating $host:$remote_dir/ (skipping the remote mkdir dfdown normally does first)."
else
  dfxfer_ensure_remote_dir "$host" "$remote_dir"
fi

dfxfer_build_opts

log_info "dfdown: $host:$remote_dir/ -> $local_dir/"

# Trailing slash on the source: copy the *contents* of the remote handoff
# directory, not the directory itself. Only fixed directory paths reach the
# command line; individual filenames travel inside the rsync protocol, which
# is why none of this needs --secluded-args / --protect-args (計画書 1.6) —
# options macOS's bundled rsync does not have anyway.
#
# --stats is captured (via `tee`, so the human still sees live -P progress)
# so "Nothing came down" can be based on *this run's* transfer count rather
# than "is the receive dir empty right now" — the latter stays wrong forever
# once a single file has ever landed in it, silently misreporting every
# later empty pull as if something had come down.
#
# It is only asked for when the binary named a version of its own, i.e. when
# it really is rsync (dfxfer_rsync_major() returns empty for openrsync, which
# recent macOS ships in rsync's place and whose option set is a subset of
# rsync's). Handing an option to something that does not know it makes it exit
# before transferring anything, and under `set -e` that would take the whole
# command down — turning a cosmetic summary line into a total failure. When
# the count is unavailable, say so and point at the receive directory rather
# than guess.
_dfdown_opts=("${DFXFER_OPTS[@]}")
_dfdown_can_count=0
if [ -n "${DFXFER_RSYNC_MAJOR:-}" ]; then
  _dfdown_opts+=(--stats)
  _dfdown_can_count=1
fi

_dfdown_stats=$(mktemp) || dfxfer_die "Failed to create a temporary file for rsync stats."
trap 'rm -f "$_dfdown_stats"' EXIT

"$DFXFER_RSYNC_CMD" \
  "${_dfdown_opts[@]}" \
  ${1+"$@"} \
  "$host:$remote_dir/" \
  "$local_dir/" | tee "$_dfdown_stats"

if [ "$_dfdown_can_count" -eq 1 ]; then
  # Both spellings are needed. rsync 3.1.0 reworded this line to say "regular
  # files"; 2.6.9 and 3.0.x — the versions this command deliberately keeps
  # working (計画書 5.1) — print "Number of files transferred:" instead.
  # Matching only the new wording means the count is never found there, and a
  # successful pull reports "Nothing came down" every single time.
  #
  # Thousands separators are rsync's default output since 3.1.0 as well
  # ("Output numbers in 3-digit groups by default", NEWS for rsync 3.1.0) and
  # have nothing to do with -h — if anything -h is the knob that turns them
  # off. Strip them before the numeric test, or a count over 999 turns into
  # two grep matches ("1" and "200") and crashes the `-eq` below with
  # "integer expression expected" on an otherwise-successful transfer.
  _dfdown_transferred=$(grep -m1 -E '^Number of (regular )?files transferred:' "$_dfdown_stats" | grep -oE '[0-9,]+' | tr -d ',' || true)
  if [ "${_dfdown_transferred:-0}" -eq 0 ]; then
    log_info "Nothing came down: no new files from $host:$remote_dir/."
  fi
else
  log_info "Done. This rsync reports no transfer statistics, so check $local_dir/ for what arrived."
fi
