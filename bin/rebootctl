#!/usr/bin/env bash
set -euo pipefail

# rebootctl — Windows の勝手な再起動からの復帰の「Windows 側の入口」。
#
#   rebootctl status [--json]   Windows と Herdr の状態を読む（読み取りだけ）
#   rebootctl setup             人間が管理者 PowerShell に貼るコマンドを表示する（実行しない）
#   rebootctl boot [--hold] [--once-per-boot]
#                               WSL 起動後に Herdr を起こし、会話の再開を呼ぶ（冪等）
#   rebootctl pause [--shutdown]  起動タスクを無効にする（WSL のイメージの圧縮などの前に。--shutdown で WSL も止める）
#   rebootctl resume            起動タスクを有効に戻す
#   rebootctl watch             再起動待ちのときだけ管制の会話へ予告を頼む（cron から1時間おきに呼ぶ）
#
# 設計と判断の根拠は ADR DOC-2611151248・DOC-2611242024（bin/README.md §3.7 に使い方）。
# 状態の置き場所は ${XDG_STATE_HOME:-~/.local/state}/reboot-recovery/ に固定
# （sessions/ と last-recovery.json は herdr-resume、boot.log はこのツールが書く）。

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/reboot-recovery"
BOOT_LOG="$STATE_DIR/boot.log"
TASK_NAME="dotfiles-reboot-recovery"
# WSL の cron は PATH に Windows 側を足さないので、powershell.exe の置き場所を自分で足す
# （status も watch も同じ条件で読めるよう、全コマンドに効かせる）
WIN_PS_DIR="${REBOOTCTL_WIN_PS_DIR:-/mnt/c/Windows/System32/WindowsPowerShell/v1.0}"
# pause / resume が Windows のタスクを変えるために呼ぶ実行ファイル（試すときは偽物に差し替える）
PAUSE_POWERSHELL="${REBOOTCTL_POWERSHELL:-powershell.exe}"
PAUSE_WSL_EXE="${REBOOTCTL_WSL_EXE:-wsl.exe}"
export PATH="$PATH:$WIN_PS_DIR"
# 起動時の差し込み口（持ち主が置いた実行ファイルを boot の最初に名前順で呼ぶ。bin/README.md §3.7）
BOOT_D="${REBOOTCTL_BOOT_D:-${XDG_CONFIG_HOME:-$HOME/.config}/reboot-recovery/boot.d}"
HOOK_TIMEOUT="${REBOOTCTL_HOOK_TIMEOUT:-60}"
# 起動の記録（boot_id・Windows の最終起動時刻・起動の種類）。管制の会話もこれを読む
BOOT_STATE="$STATE_DIR/boot-state.json"
# 会話の復元（herdr が workspace を戻す）を待つ上限秒数
RESTORE_WAIT="${REBOOTCTL_RESTORE_WAIT:-90}"
# NAS の確認先（環境依存なので既定値を持たない。未設定の確認は飛ばして「未設定」と出す）。
#   REBOOTCTL_NAS_MOUNT  WSL の中のマウント先（例: /mnt/nas。cifs でマウントしたもの）
#   REBOOTCTL_NAS_UNC    Windows から見た NAS の共有フォルダ（\\<ホスト>\<共有> 形式）
NAS_MOUNT="${REBOOTCTL_NAS_MOUNT:-}"
# 末尾の / は落とす（/proc/self/mounts の表記と突き合わせるため。/ だけは残す）
while [ "${#NAS_MOUNT}" -gt 1 ] && [ "${NAS_MOUNT%/}" != "$NAS_MOUNT" ]; do NAS_MOUNT=${NAS_MOUNT%/}; done
NAS_UNC="${REBOOTCTL_NAS_UNC:-}"
# 起動時の net use（cmd_netuse）が読む資格情報（cifs の credentials 形式。root 600）
NAS_CREDENTIALS="${REBOOTCTL_NAS_CREDENTIALS:-/etc/nas-credentials}"

POLICY_KEY_AU='HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU'
UX_KEY='HKLM:\SOFTWARE\Microsoft\WindowsUpdate\UX\Settings'
REBOOT_REQUIRED_KEY='HKLM:\SOFTWARE\Microsoft\WindowsUpdate\Auto Update\RebootRequired'

usage() {
  cat <<'EOF'
Usage: rebootctl <command>

  status [--json]   Windows の再起動ポリシー・アクティブ時間・最終起動時刻・起動タスクの登録・
                    Herdr サーバの生死・NAS に届くか（REBOOTCTL_NAS_MOUNT / REBOOTCTL_NAS_UNC が
                    設定されているとき）を読む（何も書き換えない）
  setup             管理者 PowerShell に貼るコマンドを表示する（このコマンドは何も実行しない）
  pause [--shutdown]
                    起動タスクを無効にする。WSL のイメージの圧縮・エクスポートの前に使う（無効のあいだは
                    WSL が落ちても起き直らない）。--shutdown は、無効にできたあとで wsl.exe --shutdown も打つ
                    （走っている会話・学習がすべて止まる。打つ時刻は自分で決めること）
  resume            起動タスクを有効に戻す（WSL が止まっているときは、PowerShell で戻す。pause の表示を参照）
  netuse <//ホスト/共有>
                    root で呼ぶ。/etc/nas-credentials の資格情報で、Windows 側に NAS の UNC を
                    net use で張る（起動時タスクの最初の操作。失敗しても 0 で終わる）
  watch             Windows が再起動待ちのときだけ、管制の会話（ラベル「管制」）へ予告の手順を送る。
                    再起動待ちでなければ何も送らず、モデルも呼ばない。同じ予告は1回だけ
                    （cron から1時間おきに呼ぶ。登録の1行は bin/README.md §3.7）
  boot [--hold] [--once-per-boot]
                    起動時の差し込み口（boot.d）の実行ファイルを呼び、Herdr のサーバを起こし、
                    会話の復元を待ち、herdr-resume があれば recover を呼び、
                    管制の会話（ラベル「管制」のワークスペース）が無ければ起こす。
                    何度呼んでも害は無い。--hold は最後に居座って WSL を落とさない
                    （Windows のタスクから起こすときに使う）。--once-per-boot は、この起動で
                    boot が最後まで終わっていれば何もしない（タスクの繰り返し用）
EOF
}

log() {
  mkdir -p "$STATE_DIR"
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$BOOT_LOG"
  printf '%s\n' "$*" >&2
}

json_escape() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/ }
  s=${s//$'\r'/}
  s=${s//$'\n'/ }
  printf '%s' "$s"
}

# ── Windows 側の読み取り ───────────────────────────────────────────
# powershell.exe の出力は key=value の行にそろえて返す。読めなければ非0。
read_windows() {
  command -v powershell.exe >/dev/null 2>&1 || return 1
  local ps
  ps=$(
    cat <<EOF
\$ErrorActionPreference = 'SilentlyContinue'
function V(\$path, \$name) {
  \$k = Get-Item -LiteralPath \$path
  if (\$k -and (\$k.GetValueNames() -contains \$name)) { \$k.GetValue(\$name) } else { '' }
}
'au_options=' + (V '$POLICY_KEY_AU' 'AUOptions')
'no_auto_reboot_with_logged_on_users=' + (V '$POLICY_KEY_AU' 'NoAutoRebootWithLoggedOnUsers')
'active_hours_start=' + (V '$UX_KEY' 'ActiveHoursStart')
'active_hours_end=' + (V '$UX_KEY' 'ActiveHoursEnd')
'reboot_required=' + (Test-Path -LiteralPath '$REBOOT_REQUIRED_KEY')
'last_boot=' + (Get-CimInstance Win32_OperatingSystem).LastBootUpTime.ToString('o')
'task_registered=' + [bool](Get-ScheduledTask -TaskName '$TASK_NAME')
'task_state=' + (Get-ScheduledTask -TaskName '$TASK_NAME').State
EOF
  )
  timeout 60 powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null | tr -d '\r'
}

# ── NAS の確認（読み取りだけ） ─────────────────────────────────────
# 結果は yes / no / unknown / skipped のどれか1語（標準出力）。落ちない。
#   skipped: 確認先が未設定   unknown: 確認する道具（powershell.exe / wslpath）が使えない
nas_wsl_mounted() {
  [ -n "$NAS_MOUNT" ] || {
    printf 'skipped'
    return 0
  }
  if grep -qF " $NAS_MOUNT " /proc/self/mounts 2>/dev/null && timeout 10 test -d "$NAS_MOUNT/." 2>/dev/null; then
    printf 'yes'
  else
    printf 'no'
  fi
}

# Windows のプログラムから Test-Path で $1（Windows 形式のパス）に届くか。
windows_test_path() {
  command -v powershell.exe >/dev/null 2>&1 || {
    printf 'unknown'
    return 0
  }
  local p=${1//\'/\'\'} out
  out=$(timeout 30 powershell.exe -NoProfile -NonInteractive -Command \
    "(Test-Path -LiteralPath '$p')" 2>/dev/null | tr -d '\r') || out=""
  case "$out" in
    True) printf 'yes' ;;
    False) printf 'no' ;;
    *) printf 'unknown' ;;
  esac
}

# 起動時タスク（S4U）のログオンには NAS の資格情報が無いので、タスクの最初の操作で netuse を呼んで張る
# （ADR DOC-2611151248 §8）。張れていれば UNC に届く。届かないときは boot.log の「netuse:」の行を見る。
nas_windows_unc() {
  [ -n "$NAS_UNC" ] || {
    printf 'skipped'
    return 0
  }
  windows_test_path "$NAS_UNC"
}

nas_windows_via_wsl() {
  [ -n "$NAS_MOUNT" ] || {
    printf 'skipped'
    return 0
  }
  # マウントが生きていないと、マウント先は空のディレクトリとして残り Test-Path が True になるので、先に見る
  [ "$(nas_wsl_mounted)" = yes ] || {
    printf 'no'
    return 0
  }
  command -v wslpath >/dev/null 2>&1 || {
    printf 'unknown'
    return 0
  }
  local wp
  wp=$(wslpath -w "$NAS_MOUNT" 2>/dev/null) || wp=""
  [ -n "$wp" ] || {
    printf 'unknown'
    return 0
  }
  windows_test_path "$wp"
}

herdr_state() {
  if ! command -v herdr >/dev/null 2>&1; then
    printf 'missing'
  elif herdr status server 2>/dev/null | grep -q '^status: running'; then
    printf 'running'
  else
    printf 'stopped'
  fi
}

cmd_status() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1

  local win readable=true
  if ! win=$(read_windows) || [ -z "$win" ]; then
    readable=false
    win=""
  fi
  local au='' nar='' ahs='' ahe='' rr='' lb='' tr='' ts=''
  local line key val
  while IFS= read -r line; do
    key=${line%%=*}
    val=${line#*=}
    case "$key" in
      au_options) au=$val ;;
      no_auto_reboot_with_logged_on_users) nar=$val ;;
      active_hours_start) ahs=$val ;;
      active_hours_end) ahe=$val ;;
      reboot_required) rr=$val ;;
      last_boot) lb=$val ;;
      task_registered) tr=$val ;;
      task_state) ts=$val ;;
    esac
  done <<<"$win"

  local boot_id herdr
  boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)
  herdr=$(herdr_state)
  local nas_mount nas_unc nas_via
  nas_mount=$(nas_wsl_mounted)
  nas_unc=$(nas_windows_unc)
  nas_via=$(nas_windows_via_wsl)

  if [ "$json" = 1 ]; then
    # 値が空（読めなかった・未設定）は null にする
    jv() { if [ -z "$1" ]; then printf 'null'; else printf '"%s"' "$(json_escape "$1")"; fi; }
    jb() {
      case "$1" in
        True) printf 'true' ;;
        False) printf 'false' ;;
        *) printf 'null' ;;
      esac
    }
    printf '{"windows_readable":%s,"au_options":%s,"no_auto_reboot_with_logged_on_users":%s,' \
      "$readable" "$(jv "$au")" "$(jv "$nar")"
    printf '"active_hours_start":%s,"active_hours_end":%s,"reboot_required":%s,' \
      "$(jv "$ahs")" "$(jv "$ahe")" "$(jb "$rr")"
    # NAS: yes→true / no→false / unknown→null（読めなかった）/ skipped→"skipped"（確認先が未設定）
    jn() {
      case "$1" in
        yes) printf 'true' ;;
        no) printf 'false' ;;
        skipped) printf '"skipped"' ;;
        *) printf 'null' ;;
      esac
    }
    printf '"windows_last_boot":%s,"boot_task_registered":%s,"boot_task_state":%s,"wsl_boot_id":%s,"herdr_server":"%s",' \
      "$(jv "$lb")" "$(jb "$tr")" "$(jv "$ts")" "$(jv "$boot_id")" "$herdr"
    printf '"nas_wsl_mounted":%s,"nas_windows_unc_reachable":%s,"nas_windows_via_wsl_reachable":%s}\n' \
      "$(jn "$nas_mount")" "$(jn "$nas_unc")" "$(jn "$nas_via")"
    return 0
  fi

  if [ "$readable" = false ]; then
    printf 'Windows 側: 読めませんでした（powershell.exe が無い、または失敗）\n'
  else
    printf 'Windows 側（読み取りのみ）:\n'
    printf '  AUOptions                         : %s\n' "${au:-未設定}"
    printf '  NoAutoRebootWithLoggedOnUsers     : %s\n' "${nar:-未設定}"
    printf '  アクティブ時間                    : %s 時 〜 %s 時\n' "${ahs:-?}" "${ahe:-?}"
    printf '  再起動待ち                        : %s\n' "${rr:-?}"
    printf '  最終起動時刻                      : %s\n' "${lb:-?}"
    printf '  起動タスク (%s) : %s（状態: %s）\n' "$TASK_NAME" "${tr:-?}" "${ts:-?}"
    if [ "$ts" = Disabled ]; then
      printf '  → 起動タスクが無効です（rebootctl pause のあと）。戻すには「rebootctl resume」\n'
    fi
    if [ "$au" != 4 ] || [ "$nar" != 1 ]; then
      printf '  → 再起動止めのポリシーは未適用です。「rebootctl setup」を管理者 PowerShell に貼ってください\n'
    fi
  fi
  printf 'WSL 側:\n'
  printf '  boot_id       : %s\n' "${boot_id:-?}"
  printf '  Herdr サーバ  : %s\n' "$herdr"
  printf 'NAS（確認先は REBOOTCTL_NAS_MOUNT / REBOOTCTL_NAS_UNC）:\n'
  nas_line 'WSL の中のマウント' "$nas_mount"
  nas_line 'Windows から UNC で' "$nas_unc"
  nas_line 'Windows から WSL のマウント経由で' "$nas_via"
  if [ "$nas_unc" = no ] && [ "$nas_via" = yes ]; then
    printf '  → WSL のマウントは生きているのに UNC に届きません。起動時の net use が失敗した可能性があります。boot.log の「netuse:」の行を見てください\n'
  fi
}

nas_line() {
  local label=$1 v=$2 word
  case "$v" in
    yes) word='届く' ;;
    no) word='届かない' ;;
    skipped) word='未設定（確認を飛ばした）' ;;
    *) word='確認できなかった' ;;
  esac
  printf '  %s: %s\n' "$label" "$word"
}

# ── netuse（起動時タスクの1つ目の操作。root で呼ぶ） ───────────────
# S4U のログオンには NAS の資格情報が無いので、/etc/nas-credentials の資格情報で Windows 側に UNC を張る
# （このタスクのログオンの中の net use。同じタスクで起きる WSL から呼ぶ Windows のプログラムにも効く。ADR DOC-2611151248 §8）。
# - パスワードはまず標準入力で渡す（net.exe の引数にならない）。通らなければ引数で渡し直す
# - ログには終了コードと、パスワードを伏せた net.exe の出力だけを書く
# - 失敗しても、既に張ってあっても、常に 0 で終わる（後ろの boot を止めない。冪等）
netuse_log() {
  # root が作ったログ・フォルダを持ち主が使えなくならないよう、無いときは $HOME の持ち主に合わせて作る
  if [ ! -d "$STATE_DIR" ]; then
    mkdir -p "$STATE_DIR" 2>/dev/null && chown --reference="$HOME" "$STATE_DIR" 2>/dev/null || true
  fi
  if [ -d "$STATE_DIR" ] && [ ! -e "$BOOT_LOG" ]; then
    : >"$BOOT_LOG" 2>/dev/null && chown --reference="$HOME" "$BOOT_LOG" 2>/dev/null || true
  fi
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$BOOT_LOG" 2>/dev/null || true
  printf '%s\n' "$*" >&2
}

cmd_netuse() {
  local unc=${1:-} user pass domain
  unc=${unc//\//\\}
  if [ -z "$unc" ]; then
    netuse_log "netuse: 張る先 (UNC) が渡されていないので何もしない"
    return 0
  fi
  if ! user=$(sed -n 's/^username=//p' "$NAS_CREDENTIALS" 2>/dev/null | head -n1) || [ -z "$user" ]; then
    netuse_log "netuse: 資格情報 ($NAS_CREDENTIALS) を読めないので何もしない"
    return 0
  fi
  pass=$(sed -n 's/^password=//p' "$NAS_CREDENTIALS" 2>/dev/null | head -n1)
  domain=$(sed -n 's/^domain=//p' "$NAS_CREDENTIALS" 2>/dev/null | head -n1)
  [ -z "$domain" ] || user="$domain\\$user"
  local net=net.exe
  command -v "$net" >/dev/null 2>&1 || net=/mnt/c/Windows/System32/net.exe
  [ -x "$(command -v "$net" 2>/dev/null)" ] || {
    netuse_log "netuse: net.exe が見つからないので何もしない"
    return 0
  }
  local out rc how=stdin
  rc=0
  out=$(printf '%s\n' "$pass" | timeout 30 "$net" use "$unc" '*' "/user:$user" /persistent:no 2>&1) || rc=$?
  if [ "$rc" != 0 ]; then
    how=arg
    rc=0
    out=$(timeout 30 "$net" use "$unc" "$pass" "/user:$user" /persistent:no 2>&1 </dev/null) || rc=$?
  fi
  [ -z "$pass" ] || out=${out//"$pass"/'***'}
  out=$(printf '%s' "$out" | tr -d '\r' | head -c 200 | tr '\n' ' ')
  if [ "$rc" = 0 ]; then
    netuse_log "netuse: $unc を張った（パスワードの渡し方: $how）"
  else
    netuse_log "netuse: $unc を張れなかった（終了コード $rc。渡し方: $how）（続行）: $out"
  fi
  return 0
}

# ── setup（表示だけ。ここでは powershell.exe を呼ばない） ──────────
cmd_setup() {
  local distro="${WSL_DISTRO_NAME:-Ubuntu}"
  # NAS の UNC が分かるときだけ、root で net use する操作を足す（タスクは静的で、起動時に環境変数は読めない）。
  # UNC は wsl.exe の引数でバックスラッシュが壊れないよう / 区切りで渡す（cmd_netuse が \ に戻す）
  local netuse_note netuse_action netuse_ref=""
  if [ -n "$NAS_UNC" ]; then
    local unc_fwd=${NAS_UNC//\\//}
    netuse_note="# 1つ目の操作: root で \`rebootctl netuse\`（NAS の資格情報で net use を張る。失敗しても2つ目は走る）"
    netuse_action="\$netuse = New-ScheduledTaskAction -Execute 'wsl.exe' \`
  -Argument '-d $distro -u root -- env HOME=$HOME $HOME/bin/rebootctl netuse $unc_fwd'"
    netuse_ref="\$netuse, "
  else
    netuse_note="# REBOOTCTL_NAS_UNC が未設定なので、NAS の net use の操作は含めていない。必要なら \`REBOOTCTL_NAS_UNC='\\\\<ホスト>\\<共有>' rebootctl setup\` で表示し直すこと"
    netuse_action="# （net use の操作なし）"
  fi
  cat <<EOF
# ============================================================
# rebootctl setup — 管理者 PowerShell に貼るコマンド（このコマンド自体は何も実行しません）
# ============================================================

# --- 1. 勝手な再起動を減らす（ポリシー） ---
# Microsoft の文書では、ログオン中の自動再起動を止めるには AUOptions=4 と
# NoAutoRebootWithLoggedOnUsers=1 の組が要る。Windows 11 では単独で効く保証は無く、
# あくまで最初の防壁（効かない場合に備えて 2 以降と herdr-resume がある）。
\$au = '$POLICY_KEY_AU'
New-Item -Path \$au -Force | Out-Null
Set-ItemProperty -Path \$au -Name AUOptions -Type DWord -Value 4
Set-ItemProperty -Path \$au -Name NoAutoRebootWithLoggedOnUsers -Type DWord -Value 1

# 確かめ（管理者でなくてよい。WSL 側で \`rebootctl status\` でも同じ）
Get-ItemProperty \$au | Select-Object AUOptions, NoAutoRebootWithLoggedOnUsers

# --- 2. 再起動のあと、サインイン無しで WSL と Herdr を起こすタスク（方式 A: 起動時・S4U） ---
# サインインしていなくても実行される。パスワードは保存しない（S4U）。
# 起動時に加えて5分おきにも走る。boot --hold は WSL が生きているあいだ居座って終わらず、
# 同時に2つは走らない（IgnoreNew）ので、繰り返しが効くのは WSL だけが落ちて wsl.exe が終わったあと
# （次の繰り返しで WSL ごと起こし直す）。--once-per-boot で、同じ起動では2回目以降は何もしない。
# S4U のログオンにはネットワーク資格情報が無い。この WSL から呼ぶ Windows のプログラムも同じログオンで動くので、
# 何もしないと NAS の UNC パスには届かない。そこで、1つ目の操作で root が /etc/nas-credentials の資格情報で
# net use を張ってから、2つ目の操作で boot を走らせる（ADR DOC-2611151248 §8）。起動後に「rebootctl status」の NAS の欄で確認すること。
$netuse_note
\$user = "\$env:USERDOMAIN\\\$env:USERNAME"
$netuse_action
\$action = New-ScheduledTaskAction -Execute 'wsl.exe' \`
  -Argument '-d $distro -- bash -lc "\$HOME/bin/rebootctl boot --hold --once-per-boot"'
\$actions = @($netuse_ref\$action)
\$trigger = New-ScheduledTaskTrigger -AtStartup
\$trigger.Delay = 'PT30S'
\$trigger.Repetition = (New-ScheduledTaskTrigger -Once -At (Get-Date) -RepetitionInterval (New-TimeSpan -Minutes 5)).Repetition
\$principal = New-ScheduledTaskPrincipal -UserId \$user -LogonType S4U -RunLevel Limited
\$settings = New-ScheduledTaskSettingsSet -ExecutionTimeLimit ([TimeSpan]::Zero) -MultipleInstances IgnoreNew \`
  -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable
Register-ScheduledTask -TaskName '$TASK_NAME' -Action \$actions -Trigger \$trigger \`
  -Principal \$principal -Settings \$settings -Force

# 確かめ
Get-ScheduledTask -TaskName '$TASK_NAME' | Select-Object TaskName, State

# 手で走らせて試す（WSL は落ちません。boot は冪等）
#   Start-ScheduledTask -TaskName '$TASK_NAME'
# 外すとき
#   Unregister-ScheduledTask -TaskName '$TASK_NAME' -Confirm:\$false
EOF
}

# ── pause / resume（起動タスクの無効化・有効化） ─────────────────
# 失敗（タスクが無い・権限が足りない）は非0と理由で返す。タスクを触るだけで、WSL は止めない
set_task_enabled() {
  local verb="$1" out
  command -v "$PAUSE_POWERSHELL" >/dev/null 2>&1 || {
    printf 'rebootctl: %s が使えないので、起動タスクを触れません\n' "$PAUSE_POWERSHELL" >&2
    return 1
  }
  out=$(timeout 60 "$PAUSE_POWERSHELL" -NoProfile -NonInteractive -Command \
    "\$ErrorActionPreference='Stop'; try { $verb-ScheduledTask -TaskName '$TASK_NAME' | Out-Null } catch { Write-Output \$_.Exception.Message; exit 1 }" 2>&1 | tr -d '\r') || {
    printf 'rebootctl: 起動タスクを %s できませんでした: %s\n' "$verb" "$out" >&2
    printf '  管理者 PowerShell で「%s-ScheduledTask -TaskName %s」を打ってください\n' "$verb" "$TASK_NAME" >&2
    return 1
  }
  log "$verb: 起動タスク $TASK_NAME を $verb した"
}

cmd_pause() {
  local shutdown=0
  # 決めた引数以外（--help を含む）は、何もせず使い方を出して終わる（タスクを触る前に弾く）
  case "$#:${1:-}" in
    0:) ;;
    1:--shutdown) shutdown=1 ;;
    *)
      printf 'Usage: rebootctl pause [--shutdown]\n' >&2
      return 2
      ;;
  esac
  set_task_enabled Disable || return 1
  printf '起動タスクを無効にしました。戻すまで、WSL が落ちても Windows が再起動しても、自動では起き直しません。\n'
  if [ "$shutdown" = 1 ]; then
    printf 'wsl.exe --shutdown を打ちます（この会話・学習を含め、WSL の中がすべて止まります）\n'
    log "pause: wsl.exe --shutdown を打つ"
    "$PAUSE_WSL_EXE" --shutdown
    return 0
  fi
  cat <<EOT
WSL を止めるには: PowerShell で wsl --shutdown（または rebootctl pause --shutdown）
イメージの圧縮などのあと、PowerShell で戻すには:
  Enable-ScheduledTask -TaskName '$TASK_NAME'; Start-ScheduledTask -TaskName '$TASK_NAME'
  （Start は WSL を起こして boot まで走らせる。WSL の中からは rebootctl resume でタスクを有効に戻すだけ）
EOT
}

cmd_resume() {
  if [ "$#" -gt 0 ]; then
    printf 'Usage: rebootctl resume\n' >&2
    return 2
  fi
  set_task_enabled Enable || return 1
  printf '起動タスクを有効に戻しました。5分おきの繰り返しが戻るかは確かめていません。確実に戻るのは、次の Windows の再起動のあとです（登録し直しても、起動時トリガーが発火するまで繰り返しが始まるとは限りません）。\n'
}

# ── boot ───────────────────────────────────────────────────────────
# 取りこぼし（Herdr は再起動のたびに会話を戻す側）。何度呼ばれても害が無いように、
# 実行中の boot が居れば待たずに抜け、Herdr は動いていなければ起動する。
workspace_count() {
  # 0 件・取得失敗でも 0 を返す（set -e / pipefail でスクリプトごと落とさない）
  { herdr workspace list 2>/dev/null | grep -o '"workspace_id"' || true; } | wc -l
}

# wsl.exe を終わらせない居座り。居座る間にロックを握り続けないよう fd 9 を閉じて exec する
# （居座る出口はすべてここを通す）
hold_forever() {
  exec sleep infinity 9>&-
}

# 管制の会話（skills/control-tower）を、ラベル「管制」の専用ワークスペースに起こす。
# 同じラベルのワークスペースが既にあれば何もしない（冪等。Herdr が復元したものもここで見つかる）。
# 失敗しても boot の他の手順を止めない（呼び側が || で受ける）。
CONTROL_LABEL="管制" # bin/herdr-resume の CONTROL_LABEL と同じ値（herdr-resume は管制の会話へ送らない）
CONTROL_NAME="再起動管制"
CONTROL_PROMPT="control-tower スキルの「起動時の手順」を実行する"
# 管制の会話の作業フォルダ。Claude Code は $HOME ではフォルダの信頼を保存しないので、専用のフォルダで起こす
# （最初の1回だけ人間がここで claude を開いて信頼する。bin/README.md §3.7）
CONTROL_DIR="${REBOOTCTL_CONTROL_DIR:-$STATE_DIR/control}"

# ラベル「管制」のワークスペースの先頭ペインを "<pane_id> <agent> <agent_status>" で出す（無ければ何も出さない）
control_pane_info() {
  command -v python3 >/dev/null 2>&1 || return 0
  local wl ws pl
  wl=$(herdr workspace list 2>/dev/null) || return 0
  ws=$(printf '%s' "$wl" | python3 -c '
import json, sys
label = sys.argv[1]
d = json.load(sys.stdin)
d = d.get("result", d)
for w in d.get("workspaces", []):
    if w.get("label") == label:
        print(w.get("workspace_id", ""))
        break
' "$CONTROL_LABEL" 2>/dev/null) || return 0
  [ -n "$ws" ] || return 0
  pl=$(herdr pane list --workspace "$ws" 2>/dev/null) || return 0
  printf '%s' "$pl" | python3 -c '
import json, sys
d = json.load(sys.stdin)
d = d.get("result", d)
for p in d.get("panes", []):
    print(p.get("pane_id", ""), p.get("agent") or "-", p.get("agent_status") or "-")
    break
' 2>/dev/null || true
}

# 管制の会話を起こす（無ければ作る）。既にあるときは、Herdr が復元した会話が待つだけで
# 起動時の手順（通知）が走らないので、待機中ならその手順を送る。
# 送るのは idle / done のときだけ（working・blocked には送らない＝承認の代行をしない）。
# 同じ起動での2重の通知は、スキル側の control-tower.json の印が防ぐ。
start_control_tower() {
  local info pane agent status out
  info=$(control_pane_info)
  if [ -n "$info" ]; then
    read -r pane agent status <<<"$info"
    if [ "$agent" = "-" ]; then
      # 中の Claude が終了してシェルだけになっている
      log "boot: 管制のペイン ($pane) にエージェントが居ないので起動し直す"
      herdr pane run "$pane" "claude --model sonnet --name '$CONTROL_NAME' '$CONTROL_PROMPT'" >/dev/null 2>&1 || return 1
      return 0
    fi
    case "$status" in
      idle | done)
        # --wait はターンが落ち着くまで待つので、起動時の手順（1ターンで終わらない）では timeout が通常。
        # 非0は「届いたか未確認」であって「送れなかった」ではない。再送しない
        if out=$(herdr agent prompt "$pane" "$CONTROL_PROMPT" --wait --timeout 10000 2>&1); then
          log "boot: 復元された管制の会話 ($pane) へ起動時の手順を送った"
        elif printf '%s' "$out" | grep -q 'agent_blocked'; then
          log "boot: 管制の会話 ($pane) は承認待ちで送られなかった"
        else
          log "boot: 復元された管制の会話 ($pane) へ起動時の手順を送った（届いたか未確認。再送しない）"
        fi
        ;;
      *) log "boot: 管制の会話 ($pane) は $status なので何も送らない" ;;
    esac
    return 0
  fi
  if ! command -v claude >/dev/null 2>&1; then
    log "boot: claude が見つからないので管制の会話は起こさない"
    return 0
  fi
  mkdir -p "$CONTROL_DIR" || return 1
  out=$(herdr workspace create --cwd "$CONTROL_DIR" --label "$CONTROL_LABEL" --no-focus 2>/dev/null) || return 1
  pane=$(printf '%s' "$out" | grep -o '"pane_id":"[^"]*"' | head -n1 | cut -d'"' -f4)
  [ -n "$pane" ] || return 1
  herdr pane run "$pane" "claude --model sonnet --name '$CONTROL_NAME' '$CONTROL_PROMPT'" >/dev/null 2>&1 || return 1
  log "boot: 管制の会話を起こした ($pane)"
}

# ── watch（cron から呼ぶ。再起動待ちの予告） ──────────────────────
# 再起動待ちでないときは status を読むだけで終わる（モデルを呼ばない）。再起動待ちを見つけたときだけ、
# 管制の会話へ予告の手順を送る。スマホへ通知するのは管制の会話（Remote Control がつながっている対話の
# セッション）で、cron の下の `claude -p` からはスマホへ届かない（ADR DOC-2611232111）。
# 印（announced_reboot_for）を書くのはこの関数だけ。管制の会話は書かない。
WATCH_PROMPT="control-tower スキルの「再起動の予告の手順」を実行する"
CONTROL_STATE="$STATE_DIR/control-tower.json"

# control-tower.json の announced_reboot_for を読む（無い・空は空文字）。壊れていれば失敗する
announced_get() {
  [ -f "$CONTROL_STATE" ] || return 0
  python3 -c '
import json, sys
print(json.load(open(sys.argv[1])).get("announced_reboot_for") or "")
' "$CONTROL_STATE"
}

# announced_reboot_for を書く（$1 が空なら消す）。ほかの鍵は残す。壊れていれば失敗する（上書きしない）
announced_put() {
  python3 -c '
import json, os, sys
path, value = sys.argv[1], sys.argv[2]
d = json.load(open(path)) if os.path.exists(path) else {}
if value:
    d["announced_reboot_for"] = value
else:
    d.pop("announced_reboot_for", None)
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(d, f, ensure_ascii=False)
os.replace(tmp, path)
' "$CONTROL_STATE" "$1"
}

cmd_watch() {
  # cron から呼ばれると PATH が最小（/usr/bin:/bin）になり、Windows 側の powershell.exe も見えない
  export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
  mkdir -p "$STATE_DIR"
  command -v python3 >/dev/null 2>&1 || return 0

  # 「読めた・再起動待ち・最終起動時刻」。読めない・解釈できないときは何も出さず、何もしない
  local fields readable reboot boot
  fields=$(cmd_status --json 2>/dev/null | python3 -c '
import json, sys
d = json.load(sys.stdin)
print(d.get("windows_readable") is True, d.get("reboot_required"), d.get("windows_last_boot") or "")
' 2>/dev/null) || return 0
  read -r readable reboot boot <<<"$fields"
  if [ "$readable" != True ]; then
    # 黙って止まらないよう記録する（巡回が効いていないことに気づけるように）
    log "watch: Windows 側を読めなかった（powershell.exe が PATH に無い、または失敗）"
    return 0
  fi

  if [ "$reboot" = False ]; then
    # 再起動待ちが解けた。次に現れたらまた知らせるよう、印を消す
    if [ -n "$(announced_get 2>/dev/null)" ]; then announced_put "" || log "watch: 印を消せなかった"; fi
    return 0
  fi
  [ "$reboot" = True ] && [ -n "$boot" ] || return 0

  local announced
  announced=$(announced_get) || {
    log "watch: $CONTROL_STATE が読めないので予告しない"
    return 0
  }
  [ "$announced" = "$boot" ] && return 0

  local info pane agent status out
  info=$(control_pane_info)
  if [ -z "$info" ]; then
    log "watch: 再起動待ちだが管制のワークスペースが無いので予告を送らない（次の巡回で試す）"
    return 0
  fi
  read -r pane agent status <<<"$info"
  if [ "$agent" = "-" ]; then
    log "watch: 再起動待ちだが管制のペイン ($pane) にエージェントが居ないので送らない（次の巡回で試す）"
    return 0
  fi
  case "$status" in
    idle | done) ;;
    *)
      log "watch: 再起動待ちだが管制の会話 ($pane) は $status なので送らない（次の巡回で試す）"
      return 0
      ;;
  esac

  # 手順は1ターンで終わらないので、--wait の timeout は通常。届いたかもしれない失敗（timeout / stalled）は
  # 再送しないよう、成功と同じく印を書く。承認待ち・その他の失敗は届いていないので書かず、次の巡回で試す
  if out=$(herdr agent prompt "$pane" "$WATCH_PROMPT" --wait --timeout 10000 2>&1); then
    log "watch: 管制の会話 ($pane) へ再起動待ちの予告を頼んだ"
  elif printf '%s' "$out" | grep -q 'agent_blocked'; then
    log "watch: 管制の会話 ($pane) は承認待ちで送られなかった（次の巡回で試す）"
    return 0
  elif printf '%s' "$out" | grep -Eq 'timeout|stalled'; then
    log "watch: 管制の会話 ($pane) へ再起動待ちの予告を頼んだ（届いたか未確認。再送しない）"
  else
    log "watch: 管制の会話 ($pane) へ送れなかった（次の巡回で試す）"
    return 0
  fi
  announced_put "$boot" || log "watch: 印を書けなかった（次の巡回で同じ予告を繰り返しうる）"
}

# ── 起動の種類と差し込み口 ─────────────────────────────────────────
# boot-state.json の鍵を読む（無い・壊れている・python3 が無いときは空）
boot_state_get() {
  [ -f "$BOOT_STATE" ] || return 0
  python3 -c '
import json, sys
print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))
' "$BOOT_STATE" "$1" 2>/dev/null || true
}

# boot-state.json を書く: boot_id・windows_last_boot・cause・finished(true/false)
boot_state_put() {
  command -v python3 >/dev/null 2>&1 || return 0
  python3 -c '
import json, os, sys
path, boot_id, win, cause, finished = sys.argv[1:6]
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump({"boot_id": boot_id, "windows_last_boot": win, "cause": cause,
               "finished": finished == "true"}, f, ensure_ascii=False)
os.replace(tmp, path)
' "$BOOT_STATE" "$1" "$2" "$3" "$4" || log "boot: boot-state.json を書けなかった"
}

# 起動の種類: windows_reboot（Windows の最終起動時刻が前回と違う）/ wsl_restart（同じ）/ unknown（読めない・前回が無い）
# 同じ boot_id の再実行は、最初に決めた種類をそのまま使う（自分の記録と比べて wsl_restart と取り違えない）
classify_boot() {
  local boot_id="$1" win="$2" prev_id prev_win
  prev_id=$(boot_state_get boot_id)
  if [ "$prev_id" = "$boot_id" ]; then
    boot_state_get cause
    return 0
  fi
  prev_win=$(boot_state_get windows_last_boot)
  if [ -z "$win" ] || [ -z "$prev_win" ]; then
    printf 'unknown'
  elif [ "$win" = "$prev_win" ]; then
    printf 'wsl_restart'
  else
    printf 'windows_reboot'
  fi
}

# 持ち主が置いた実行ファイルを名前順に1本ずつ呼ぶ。1本の失敗・時間切れで残りを止めない。
# 出力は boot.log へ。ロックの fd 9 は渡さない。環境変数は REBOOTCTL_BOOT_CAUSE / _BOOT_ID / _WINDOWS_LAST_BOOT
run_boot_hooks() {
  [ -d "$BOOT_D" ] || return 0
  local LC_COLLATE=C f rc
  for f in "$BOOT_D"/*; do
    [ -f "$f" ] && [ -x "$f" ] || continue
    log "boot: 差し込み口 ${f##*/} を呼ぶ（上限 ${HOOK_TIMEOUT} 秒）"
    rc=0
    REBOOTCTL_BOOT_CAUSE="$1" REBOOTCTL_BOOT_ID="$2" REBOOTCTL_WINDOWS_LAST_BOOT="$3" \
      timeout -k 5 "$HOOK_TIMEOUT" "$f" </dev/null >>"$BOOT_LOG" 2>&1 9>&- || rc=$?
    case "$rc" in
      0) log "boot: 差し込み口 ${f##*/} 完了" ;;
      124 | 137) log "boot: 差し込み口 ${f##*/} が時間切れ（続行）" ;;
      *) log "boot: 差し込み口 ${f##*/} が失敗 (終了コード $rc)（続行）" ;;
    esac
  done
}

cmd_boot() {
  local hold=0 once=0 arg
  for arg in "$@"; do
    case "$arg" in
      --hold) hold=1 ;;
      --once-per-boot) once=1 ;;
    esac
  done

  # タスクから呼ばれると PATH が最小になりうる
  export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
  mkdir -p "$STATE_DIR"

  if command -v flock >/dev/null 2>&1; then
    exec 9>"$STATE_DIR/boot.lock"
    if ! flock -n 9; then
      log "boot: 別の boot が実行中のため何もしない"
      [ "$hold" = 1 ] && hold_forever
      return 0
    fi
  fi

  local boot_id win cause
  boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)

  if [ "$once" = 1 ] && [ "$(boot_state_get boot_id)" = "$boot_id" ] && [ "$(boot_state_get finished)" = True ]; then
    log "boot: この起動 (boot_id=$boot_id) では実行済みなので何もしない"
    [ "$hold" = 1 ] && hold_forever
    return 0
  fi

  win=$(read_windows 2>/dev/null | sed -n 's/^last_boot=//p' | head -n1 || true)
  cause=$(classify_boot "$boot_id" "$win")
  # 読めなかったときは空のまま記録・受け渡しする（前回の値を残すと、次の判定が誤った種類になる）
  boot_state_put "$boot_id" "$win" "$cause" false
  log "boot: 開始 (boot_id=$boot_id, 起動の種類=$cause)"

  # 起動時の差し込み口。会話の復元を待つより前に呼ぶ（GPU を早く埋めたい呼び先のため）
  run_boot_hooks "$cause" "$boot_id" "$win"

  if ! command -v herdr >/dev/null 2>&1; then
    log "boot: herdr が見つからない。何もせず終える"
    [ "$hold" = 1 ] && hold_forever
    return 0
  fi

  # (1) Herdr のサーバが動いていなければ起動する
  if [ "$(herdr_state)" = running ]; then
    log "boot: Herdr サーバは稼働中"
  else
    log "boot: Herdr サーバを起動する"
    # ロックの fd 9 を引き継がせない（常駐するサーバがロックを握り続けるため）
    setsid nohup herdr server >>"$STATE_DIR/herdr-server.out" 2>&1 </dev/null 9>&- &
    local i=0
    while [ "$i" -lt 30 ] && [ "$(herdr_state)" != running ]; do
      sleep 1
      i=$((i + 1))
    done
    log "boot: Herdr サーバ ($(herdr_state))"
  fi

  # (2) 会話（workspace）の復元を待つ。数が2回続けて同じになったら戻り終えたとみなす
  local waited=0 prev=-1 cur
  while [ "$waited" -lt "$RESTORE_WAIT" ]; do
    cur=$(workspace_count)
    if [ "$cur" -gt 0 ] && [ "$cur" = "$prev" ]; then
      break
    fi
    prev=$cur
    sleep 3
    waited=$((waited + 3))
  done
  log "boot: workspace 数=${cur:-0}（${waited} 秒待った）"

  # (3) herdr-resume があれば recover（無ければ飛ばす。失敗しても止まらない）
  if command -v herdr-resume >/dev/null 2>&1; then
    if herdr-resume recover >>"$BOOT_LOG" 2>&1; then
      log "boot: herdr-resume recover 完了"
    else
      log "boot: herdr-resume recover が失敗（続行）"
    fi
  else
    log "boot: herdr-resume が無いので再開の送信は飛ばす"
  fi

  # (4) 管制の会話を起こす（無ければ。失敗しても続行）
  if ! start_control_tower; then
    log "boot: 管制の会話を起こせなかった（続行）"
  fi

  boot_state_put "$boot_id" "$win" "$cause" true
  log "boot: 終了"
  if [ "$hold" = 1 ]; then
    # wsl.exe を終わらせない（アイドル停止で WSL ごと落ちるのを防ぐ）。
    # 居座る間にロックを握り続けないよう fd 9 を閉じてから exec する
    hold_forever
  fi
}

main() {
  local cmd="${1:-}"
  [ "$#" -gt 0 ] && shift
  case "$cmd" in
    status) cmd_status "$@" ;;
    setup) cmd_setup ;;
    pause) cmd_pause "$@" ;;
    resume) cmd_resume "$@" ;;
    watch) cmd_watch ;;
    netuse) cmd_netuse "$@" ;;
    boot) cmd_boot "$@" ;;
    -h | --help | help | "") usage ;;
    *)
      printf 'rebootctl: unknown command: %s\n' "$cmd" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
