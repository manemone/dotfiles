{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mkdir -p *)",
      "Bash(chmod +x *)",
      "Bash(rm -r /tmp/tmp.*)",
      "Bash(rm -rf /tmp/tmp.*)",
      "Bash(rm -fr /tmp/tmp.*)",
      "Bash(rm -r /tmp/claude-*)",
      "Bash(rm -rf /tmp/claude-*)",
      "Bash(rm -fr /tmp/claude-*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/master.key)",
      "Read(./config/credentials*.yml.enc)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./config/master.key)",
      "Edit(./config/credentials*.yml.enc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/deepseek/**)",
      "Read(~/.config/opencode/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/deepseek/**)",
      "Edit(~/.config/opencode/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.git-credentials)",
      "Edit(~/.netrc)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push *:main*)",
      "Bash(git push *:master*)",
      "Bash(git push *heads/main*)",
      "Bash(git push *heads/master*)",
      "Bash(rm -r /home*)",
      "Bash(rm -rf /home*)",
      "Bash(rm -fr /home*)",
      "Bash(rm -r /usr*)",
      "Bash(rm -rf /usr*)",
      "Bash(rm -fr /usr*)",
      "Bash(rm -r /etc*)",
      "Bash(rm -rf /etc*)",
      "Bash(rm -fr /etc*)",
      "Bash(rm -r /var*)",
      "Bash(rm -rf /var*)",
      "Bash(rm -fr /var*)",
      "Bash(rm -r /mnt*)",
      "Bash(rm -rf /mnt*)",
      "Bash(rm -fr /mnt*)",
      "Bash(rm -r /opt*)",
      "Bash(rm -rf /opt*)",
      "Bash(rm -fr /opt*)",
      "Bash(rm -r ~*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -r $HOME*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -fr $HOME*)",
      "Bash(rm -r /Users*)",
      "Bash(rm -rf /Users*)",
      "Bash(rm -fr /Users*)",
      "Bash(rmdir *)",
      "Bash(sudo *)",
      "Bash(chmod -R *)",
      "Bash(chmod --recursive *)",
      "Bash(chmod * -R *)",
      "Bash(chmod * --recursive *)",
      "Bash(chmod * /*)",
      "Bash(chmod * ~*)",
      "Bash(chmod * $HOME*)",
      "Bash(chown *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(shred *)",
      "Bash(truncate *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/git-guard.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "model": "opus",
  "language": "Japanese",
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "statusLine": {
    "type": "command",
    "command": "ocw-meter snapshot-quota"
  }
}
