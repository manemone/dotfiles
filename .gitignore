# ocw-meter observation data must never land in the repo (belt-and-suspenders;
# the real storage root lives under ~/.local/state/ocw-meter, outside any
# worktree, and ocw-meter itself refuses to write inside one)
*.ocw-meter.jsonl
/ocw-meter-state/
